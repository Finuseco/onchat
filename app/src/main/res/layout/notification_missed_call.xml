<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="#1E1B4B">

    <!-- Avatar with red border (Left) -->
    <ImageView
        android:id="@+id/notif_caller_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:contentDescription="Avatar de l'appelant" />

    <!-- Center text: Name, Status, Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/notif_caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Nom de l'appelant" />

        <TextView
            android:id="@+id/notif_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F87171"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Appel manqué OnChat" />

        <TextView
            android:id="@+id/notif_call_wallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Appuyez pour rappeler" />
    </LinearLayout>

    <!-- OnChat Circular App Logo Badge (Right) -->
    <ImageView
        android:id="@+id/notif_app_logo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:scaleType="centerCrop"
        android:contentDescription="Logo OnChat" />
</LinearLayout>
